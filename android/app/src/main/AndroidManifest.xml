<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Lets the drawer's "uninstall" quick action open Android's uninstall
         confirmation dialog (API 28+). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- The files tile: browsing and deleting anywhere on the phone's
         storage (not just this app's own folder), the way Android's own
         Files app can. A "special access" permission the user grants once
         from its own Settings screen, not a runtime dialog — `tools:ignore`
         only silences the lint warning that scoped storage is the usual
         path; a file explorer is exactly the kind of app this permission
         exists for. Meaningless below Android 11 (API 30); older phones
         simply never see the toggle granted. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- The rotation-lock tile: toggling Android's own auto-rotate setting
         (the same one the quick-settings tile flips) needs WRITE_SETTINGS, a
         "special access" permission granted once from its own Settings
         screen, never a runtime dialog. Reading the setting needs no
         permission at all. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- New-mail alerts (a setting, off until turned on): the notification
         for each new unread email. A runtime permission on Android 13+, asked
         for when the setting is switched on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The INSTANT setting keeps a connection to the mail server open from a
         foreground service (with the permanent notification Android requires
         for one), and asks once to be left out of battery saving so Android
         does not stop it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- The weather tile fetches forecasts (SMHI, Open-Meteo)... -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ...for roughly where the phone is. Coarse only: a forecast needs no
         more, and precise location is never requested. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Asked for only when the add/edit event form saves or deletes. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Contact tiles: read the phone book. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Asked for only when CALL is tapped; refused, the dialer opens instead. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Asked for only when SEND is tapped on a message the user typed. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Timers and alarms: set through the phone's clock app, which does the
         ringing. A normal permission, granted at install; no exact-alarm access
         is needed because nothing here schedules anything itself. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Swipe down on Home can pull the notification shade or quick settings
         down for you. A normal permission, granted at install; it can only
         open them, not read what is in them. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Settings can put one of the launcher's own pictures on the lock screen
         or home screen, only when the button is tapped and confirmed. A normal
         permission, granted at install. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Lets the silent-mode/vibration-mode tiles query and (once the user
         grants Do-Not-Disturb access via Settings) set the ringer mode. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- The QR scanner tile: reads a frame from the camera to decode a QR
         code, never records or takes a picture. Asked for only when the tile
         opens the scanner. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- No auto-backup: the mail account is kept encrypted with a key that
         lives only in this phone's Keystore, so a restored copy of the
         encrypted file could never be read. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />

            <!-- Required by the Flutter CLI (`flutter run`) to discover and launch
                 the app. It also gives the launcher an ordinary drawer icon, which
                 is why the app list has to exclude our own package. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Makes the app selectable as a default Android home launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The Now Playing tile: reads title/artist/art and sends
             play/pause/skip to whatever app owns the active media session
             (Spotify, YouTube Music, a podcast app...).
             MediaSessionManager.getActiveSessions needs the caller to name
             an enabled NotificationListenerService of its own, even though
             nothing here ever reads a notification's content — this
             service exists only to satisfy that. Notification access is a
             "special access" permission granted once from its own Settings
             screen, never a runtime dialog. -->
        <service
            android:name=".MediaNotificationListenerService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- The service flutter_foreground_task runs the instant mail watch
             in. The type is "special use": there is no ready-made type for
             "keeps a mail connection open", and the data-sync type is cut to
             six hours a day on Android 15. The service name is the package's
             and must not change. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a connection to the user's own mail server open to announce new email at once" />
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <!-- Required to query activities that can process text, see:
             https://developer.android.com/training/package-visibility and
             https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

             In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Lets the launcher see the apps it is meant to list and open. The
             minimal alternative to the Play-restricted QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
