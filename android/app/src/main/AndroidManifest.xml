<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lets the drawer's "uninstall" quick action open Android's uninstall
         confirmation dialog (API 28+). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- The weather tile fetches forecasts (SMHI, Open-Meteo)... -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ...for roughly where the phone is. Coarse only: a forecast needs no
         more, and precise location is never requested. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Contact tiles: read the phone book. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Asked for only when CALL is tapped; refused, the dialer opens instead. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Asked for only when SEND is tapped on a message the user typed. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Timers and alarms: set through the phone's clock app, which does the
         ringing. A normal permission, granted at install; no exact-alarm access
         is needed because nothing here schedules anything itself. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Swipe down on Home can pull the notification shade or quick settings
         down for you. A normal permission, granted at install; it can only
         open them, not read what is in them. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Settings can put one of the launcher's own pictures on the lock screen
         or home screen, only when the button is tapped and confirmed. A normal
         permission, granted at install. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Lets the silent-mode/vibration-mode tiles query and (once the user
         grants Do-Not-Disturb access via Settings) set the ringer mode. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- No auto-backup: the mail account is kept encrypted with a key that
         lives only in this phone's Keystore, so a restored copy of the
         encrypted file could never be read. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />

            <!-- Required by the Flutter CLI (`flutter run`) to discover and launch
                 the app. It also gives the launcher an ordinary drawer icon, which
                 is why the app list has to exclude our own package. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Makes the app selectable as a default Android home launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <!-- Required to query activities that can process text, see:
             https://developer.android.com/training/package-visibility and
             https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

             In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Lets the launcher see the apps it is meant to list and open. The
             minimal alternative to the Play-restricted QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
